<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>OTP Verification</title>
  </head>

  <body style="margin:0; padding:0; font-family: 'Arial', sans-serif; background-color:#f6f6f6;">
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#f6f6f6; padding:30px 0;">
      <tr>
        <td align="center">
          <table width="500" cellpadding="0" cellspacing="0" style="background-color:#ffffff; border-radius:8px; padding:30px; box-shadow:0 2px 8px rgba(0,0,0,0.1);">
            
            <tr>
              <td align="center" style="padding-bottom:20px;">
                <h2 style="color:#333; margin:0;"></h2>
              </td>
            </tr>

            <tr>
              <td>
                <p style="font-size:16px; color:#555;">Hi {{name}},</p>
                <p style="font-size:16px; color:#555; line-height:1.6;">
                  Your One-Time Password (OTP) for verification is:
                </p>
                <p style="font-size:32px; font-weight:bold; letter-spacing:4px; color:#007BFF; text-align:center; margin:25px 0;">
                  {{otp}}
                </p>
                <p style="font-size:14px; color:#777;">
                  This OTP is valid for the next <b>5 minutes</b>. Please do not share it with anyone.
                </p>
                <p style="font-size:14px; color:#999; margin-top:40px;">
                  If you didn’t request this, please ignore this email.
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding-top:30px; border-top:1px solid #eee;">
                <p style="font-size:12px; color:#999;">
